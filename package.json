{
  "name": "poolclubs-ranking",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "vite dev --host",
    "build": "vite build && tsc --noEmit -p tsconfig.app.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "preview": "vite preview",
    "db:sql": "supabase db query --linked -f",
    "db:dump": "supabase db dump --linked -f sql/schema.sql",
    "db:types": "supabase gen types typescript --linked --schema public > src/types/database.types.gen.ts",
    "start": "node .output/server/index.mjs",
    "test": "vitest run",
    "screenshots": "node scripts/screenshots.mjs",
    "clubs:es": "node scripts/es-clubs.mjs",
    "clubs:es:mine": "node scripts/es-clubs-cuescore.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.114.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-router-ssr-query": "^1.167.2",
    "@tanstack/react-start": "^1.168.49",
    "maplibre-gl": "^6.7.0",
    "pureimage": "^0.4.20",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "react-icons": "^5.7.0",
    "react-map-gl": "^8.1.3",
    "react-toastify": "^11.1.0",
    "recharts": "^3.10.1",
    "uqr": "^0.1.3",
    "web-push": "^3.6.7",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@netlify/vite-plugin-tanstack-start": "^1.3.19",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.6",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "supabase": "^2.116.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "_comment": "optionalDependencies pin every native binary this build needs, one entry per platform: the linux x64 pair for CI and deploy, the darwin arm64 one for local work. They must be OPTIONAL, not devDependencies — npm fails an install outright (EBADPLATFORM) on a non-optional package whose os/cpu does not match the machine, so a mac-only binding listed as a devDependency breaks the linux build the moment the node_modules cache misses. Optional means npm skips the ones that do not apply. Vite 8 bundles with rolldown, so esbuild/rollup/swc are no longer in the tree.",
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "^1.2.7",
    "@rolldown/binding-linux-x64-gnu": "^1.2.7",
    "@rolldown/binding-linux-x64-musl": "^1.2.7",
    "@tailwindcss/oxide-linux-x64-gnu": "^4.3.3",
    "@tailwindcss/oxide-linux-x64-musl": "^4.3.3",
    "lightningcss-linux-x64-gnu": "^1.33.0",
    "lightningcss-linux-x64-musl": "^1.33.0"
  }
}
